<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- 1. Window action to open price rules in a dedicated list view -->
        <record id="action_pricelist_items_custom" model="ir.actions.act_window">
            <field name="name">Price Rules</field>
            <field name="res_model">product.pricelist.item</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('pricelist_id', '=', active_id)]</field>
            <field name="context">{'default_pricelist_id': active_id}</field>
            <field name="target">current</field>
        </record>

        <!-- 2. Smart Button addition to the Pricelist form view -->
        <record id="product_pricelist_view_inherit_button" model="ir.ui.view">
            <field name="name">product.pricelist.form.inherit.button</field>
            <field name="model">product.pricelist</field>
            <field name="inherit_id" ref="product.product_pricelist_view"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="inside">
                    <div class="oe_button_box" name="button_box" position="first">
                        <button name="%(action_pricelist_items_custom)d" 
                                type="action" 
                                class="oe_stat_button" 
                                icon="fa-list">
                            <div class="o_stat_info">
                                <span class="o_stat_text">View / Search</span>
                                <span class="o_stat_text">Rules</span>
                            </div>
                        </button>
                    </div>
                </xpath>
            </field>
        </record>

        <!-- 3. Overwritten Pricelist Item List View (Editable Matrix) -->
         <record id="product_pricelist_item_tree_view_inherit" model="ir.ui.view">
            <field name="name">product.pricelist.item.list.inherit.editable</field>
            <field name="model">product.pricelist.item</field>
            <field name="inherit_id" ref="product.product_pricelist_item_tree_view"/>
            <field name="arch" type="xml">
                
                <!-- Replace the root node of the list view -->
                <xpath expr="." position="replace">
                    <list string="Pricelist Items" 
                          editable="bottom" 
                          multi_edit="1" 
                          js_class="pricelist_item_list_modal">
                        
                        <!-- Load the invisible fields -->
                        <field name="compute_price" column_invisible="1"/>
                        <field name="pricelist_id" column_invisible="1"/>
                        <field name="currency_id" column_invisible="1"/>

                        <!-- Price rule definition name -->
                        <field name="price" 
                               string="Price Rule" 
                               optional="show" 
                               readonly="compute_price == 'formula'"/>

                        <!-- Price rule type icon -->
                        <button name="action_open_pricelist_item_modal" 
                                type="object" 
                                icon="fa-tag" 
                                title="Edit Price Rule (Fixed Price)" 
                                class="btn-link text-primary p-0 me-1"
                                invisible="compute_price != 'fixed'"/>

                        <button name="action_open_pricelist_item_modal" 
                                type="object" 
                                icon="fa-percent" 
                                title="Edit Price Rule (Percentage)" 
                                class="btn-link text-success p-0 me-1"
                                invisible="compute_price != 'percentage'"/>

                        <button name="action_open_pricelist_item_modal" 
                                type="object" 
                                icon="fa-calculator" 
                                title="Edit Price Rule (Formula)" 
                                class="btn-link text-warning p-0 me-1"
                                invisible="compute_price != 'formula'"/>

                        <!-- Price rule application type -->
                        <field name="applied_on" 
                               string="Apply On" 
                               optional="show" 
                               readonly="compute_price == 'formula'"/>

                        <!-- Element applied to. join product, variant and category -->
                        <field name="name" 
                               string="Applied Item" 
                               optional="show" 
                               readonly="compute_price == 'formula'"/>

                        <!-- Product, Variant and Category fields -->
                        <field name="product_tmpl_id" 
                               string="Product" 
                               widget="many2one"
                               invisible="applied_on != '1_product'" 
                               required="applied_on == '1_product'" 
                               optional="hide"
                               readonly="compute_price == 'formula'"/>
                               
                        <field name="product_id" 
                               string="Product Variant" 
                               widget="many2one"
                               invisible="applied_on != '0_product_variant'" 
                               required="applied_on == '0_product_variant'" 
                               optional="hide"
                               readonly="compute_price == 'formula'"/>
                               
                        <field name="categ_id" 
                               string="Category" 
                               widget="many2one"
                               invisible="applied_on != '2_product_category'" 
                               required="applied_on == '2_product_category'" 
                               optional="hide"
                               readonly="compute_price == 'formula'"/>
                        
                        <!-- Button to view product sales history -->
                        <button name="action_view_sales"
                                type="object" 
                                string="Sold" 
                                icon="fa-shopping-cart" 
                                title="View product sales history"
                                class="btn-link"/>

                        <!-- Computed financial columns -->
                        <field name="product_cost" 
                               string="Cost" 
                               widget="monetary" 
                               options="{'currency_field': 'currency_id'}"
                               optional="show" 
                               readonly="1"/>
                               
                        <field name="profit_amount" 
                               string="Profit" 
                               widget="monetary" 
                               options="{'currency_field': 'currency_id'}"
                               optional="show" 
                               readonly="compute_price == 'formula'"/>
                               
                        <field name="profit_margin" 
                               string="Profit Margin (%)" 
                               widget="percentage" 
                               optional="show" 
                               readonly="compute_price == 'formula'"/>
                               
                        <field name="markup_percent" 
                               string="Markup (%)" 
                               widget="percentage" 
                               optional="hide" 
                               readonly="compute_price == 'formula'"/>

                        <!-- Native price rule parameters  -->
                        <field name="min_quantity" 
                               optional="show" 
                               readonly="compute_price == 'formula'"/>
                        <field name="date_start" optional="hide"/>
                        <field name="date_end" optional="hide"/>
                        <field name="company_id" groups="base.group_multi_company" optional="hide"/>

                    </list>
                </xpath>

            </field>
        </record>

        <!-- Extension of the search view to include financial metrics -->
        <record id="product_pricelist_item_view_search_inherit" model="ir.ui.view">
            <field name="name">product.pricelist.item.search.inherit.financials</field>
            <field name="model">product.pricelist.item</field>
            <field name="inherit_id" ref="product.product_pricelist_item_view_search"/>
            <field name="arch" type="xml">
                
                <xpath expr="//search" position="inside">
                    <!-- 1. FIELDS FOR DIRECT SEARCH AND AUTOCOMPLETE -->
                    <field name="product_cost" string="Cost"/>
                    <field name="profit_amount" string="Profit"/>
                    <field name="profit_margin" string="Profit Margin (%)"/>
                    <field name="markup_percent" string="Markup (%)"/>

                    <separator/>

                    <!-- 2. FAST PREDEFINED FILTERS -->
                    <filter string="Cost (&gt; 0)" 
                            name="filter_cost_gt_zero" 
                            domain="[('product_cost', '&gt;', 0)]"/>
                    <filter string="Zero cost (= 0)" 
                            name="filter_cost_zero" 
                            domain="[('product_cost', '=', 0)]"/>
                            
                    <separator/>

                    <filter string="Profit (&gt; 0)" 
                            name="filter_profit_positive" 
                            domain="[('profit_amount', '&gt;', 0)]"/>
                    <filter string="Loss (&lt; 0)" 
                            name="filter_profit_negative" 
                            domain="[('profit_amount', '&lt;', 0)]"/>

                    <separator/>

                    <filter string="Margin low (&lt; 20%)" 
                            name="filter_margin_low" 
                            domain="[('profit_margin', '&lt;', 0.20)]"/>
                    <filter string="Margin high (&gt; 50%)" 
                            name="filter_margin_high" 
                            domain="[('profit_margin', '&gt;', 0.50)]"/>

                    <separator/>

                    <!-- 3. GROUPINGS IN THE DROPDOWN MENU -->
                    <group expand="0" string="Group By">
                        <filter string="Cost" 
                                name="groupby_product_cost" 
                                context="{'group_by': 'product_cost'}"/>
                        <filter string="Profit Margin (%)" 
                                name="groupby_profit_margin" 
                                context="{'group_by': 'profit_margin'}"/>
                    </group>
                </xpath>

            </field>
        </record>
        

    </data>
</odoo>