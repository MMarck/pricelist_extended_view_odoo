<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- 1. Window action to open price rules in a dedicated list view -->
        <record id="action_pricelist_items_custom" model="ir.actions.act_window">
            <field name="name">Price Rules</field>
            <field name="res_model">product.pricelist.item</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('pricelist_id', '=', active_id)]</field>
            <field name="context">{'default_pricelist_id': active_id}</field>
            <field name="target">current</field>
        </record>

        <!-- 2. Smart Button addition to the Pricelist form view -->
        <record id="product_pricelist_view_inherit_button" model="ir.ui.view">
            <field name="name">product.pricelist.form.inherit.button</field>
            <field name="model">product.pricelist</field>
            <field name="inherit_id" ref="product.product_pricelist_view"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="inside">
                    <div class="oe_button_box" name="button_box" position="first">
                        <button name="%(action_pricelist_items_custom)d" 
                                type="action" 
                                class="oe_stat_button" 
                                icon="fa-list">
                            <div class="o_stat_info">
                                <span class="o_stat_text">View / Search</span>
                                <span class="o_stat_text">Rules</span>
                            </div>
                        </button>
                    </div>
                </xpath>
            </field>
        </record>

        <!-- 3. Inherited Pricelist Item List View (Editable Matrix) -->
        <record id="product_pricelist_item_tree_view_inherit" model="ir.ui.view">
            <field name="name">product.pricelist.item.list.inherit.editable</field>
            <field name="model">product.pricelist.item</field>
            <field name="inherit_id" ref="product.product_pricelist_item_tree_view"/>
            <field name="arch" type="xml">
                
                <!-- 3.1. Make the list view editable inline -->
                <xpath expr="." position="attributes">
                    <attribute name="editable">bottom</attribute>
                    <attribute name="multi_edit">1</attribute>
                    <attribute name="js_class">pricelist_item_list_modal</attribute>
                </xpath>

                <!-- 3.2. Make the Pricelist column optional (hidden by default) -->
                <xpath expr="//field[@name='pricelist_id']" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>

                <xpath expr="//field[@name='pricelist_id']" position="before">
                    <field name="price" string="Price Rule" optional="show"/>
                    <button name="action_open_pricelist_item_modal" 
                            type="object" 
                            icon="fa-external-link" 
                            title="Open Rule Configuration Modal" 
                            class="btn-link"/>
                </xpath>

               
                <xpath expr="//field[@name='price'][last()]" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>

                <!-- 3.3. Replace the name column with direct model links and Sales button -->
                <xpath expr="//field[@name='name']" position="replace">
                    <field name="applied_on" string="Apply On" optional="show"/>
                    <field name="name" string="Applied Item" optional="show"/>
                           
                    <!-- SALES BUTTON -->
                    <button name="action_view_sales"
                            type="object" 
                            string="Sold" 
                            icon="fa-shopping-cart" 
                            title="View product sales history"
                            class="btn-link"/>                           
                </xpath>

                <!-- 3.4. Computed financial columns -->
                <xpath expr="//button[@name='action_view_sales']" position="after">
                    <field name="product_cost" string="Cost" widget="monetary" optional="show" readonly="1"/>
                    <field name="profit_amount" string="Profit" widget="monetary" optional="show"/>
                    <field name="profit_margin" string="Profit Margin (%)" widget="percentage" optional="show" readonly="0"/>
                    <field name="markup_percent" string="Markup (%)" widget="percentage" optional="hide"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>